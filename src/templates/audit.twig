{% extends '_layouts/cp' %}

{% set title = 'MCP – Audit log'|t('mcp-server') %}

{% block content %}
  {% if entries|length %}
    <table class="data fullwidth">
      <thead>
        <tr>
          <th>{{ 'Time'|t('mcp-server') }}</th>
          <th>{{ 'Token'|t('mcp-server') }}</th>
          <th>{{ 'Tool'|t('mcp-server') }}</th>
          <th>{{ 'Arguments'|t('mcp-server') }}</th>
          <th>{{ 'Result'|t('mcp-server') }}</th>
          <th>ms</th>
        </tr>
      </thead>
      <tbody>
        {% for e in entries %}
          <tr>
            <td>{{ e.dateCreated|date('short') }} {{ e.dateCreated|time('medium') }}</td>
            <td>{{ e.tokenName ?? '–' }}</td>
            <td><code>{{ e.tool }}</code></td>
            <td style="max-width:360px;word-break:break-all"><small>{{ e.arguments }}</small></td>
            <td>{% if e.success %}<span class="status green"></span> {{ 'ok'|t('mcp-server') }}{% else %}<span class="status red"></span> {{ e.message }}{% endif %}</td>
            <td>{{ e.durationMs }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="light">{{ 'No calls logged yet.'|t('mcp-server') }}</p>
  {% endif %}
{% endblock %}
